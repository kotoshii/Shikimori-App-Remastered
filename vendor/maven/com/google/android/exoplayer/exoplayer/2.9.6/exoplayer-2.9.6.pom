<?xml version="1.0" encoding="UTF-8"?>
<!-- Written for this repository: the original pom is no longer published anywhere (see the
     README.md at the root of vendor/maven). Same coordinates and dependencies as before. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.google.android.exoplayer</groupId>
    <artifactId>exoplayer</artifactId>
    <version>2.9.6</version>
    <packaging>aar</packaging>
    <licenses>
        <license>
            <name>Apache-2.0</name>
        </license>
    </licenses>
    <dependencies>
        <dependency>
            <groupId>com.google.android.exoplayer</groupId>
            <artifactId>exoplayer-core</artifactId>
            <version>2.9.6</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.google.android.exoplayer</groupId>
            <artifactId>exoplayer-dash</artifactId>
            <version>2.9.6</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.google.android.exoplayer</groupId>
            <artifactId>exoplayer-hls</artifactId>
            <version>2.9.6</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.google.android.exoplayer</groupId>
            <artifactId>exoplayer-smoothstreaming</artifactId>
            <version>2.9.6</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.google.android.exoplayer</groupId>
            <artifactId>exoplayer-ui</artifactId>
            <version>2.9.6</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>
</project>
