<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="PopupMenuTheme" parent="Widget.AppCompat.ListPopupWindow">
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:popupBackground">?attr/dialogCustomBackground</item>
        <item name="android:colorBackground">?attr/colorDialogSurface</item>
    </style>

    <!--The clock face a faint circle on every theme, in the dividers' colour: its numbers take the
    theme's text colour, white on dark and Amoled. Set in ShikimoriAppTheme.Base, so every Android
    version gets it: values-v23/v27 replaced the v21 theme that set it, and Android 6+ drew a light
    grey face under white numbers (P7-T5 Test 75h)-->
    <style name="TimePickerStyle" parent="@android:style/Widget.Material.Light.TimePicker">
        <item name="android:numbersBackgroundColor">?attr/colorDivider</item>
    </style>

    <!--Amoled's ⋮ menus: black with a thin border like its other surfaces (BUGS #17). A toolbar's ⋮
    takes its background from this style, not from PopupMenuTheme's android:popupBackground: the
    platform's popup style sets its own, and a style wins over a theme value-->
    <style name="AmoledOverflowMenu" parent="Widget.MaterialComponents.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_amoled</item>
    </style>

    <style name="ToolbarStyle" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:textColorPrimary">?attr/colorOnPrimary</item>
        <item name="android:textColorSecondary">?attr/colorOnPrimarySecondary</item>
        <item name="actionMenuTextColor">?attr/colorOnPrimary</item>
        <item name="titleTextAppearance">@style/ToolbarTextAppearance</item>
    </style>

    <style name="ToolbarTextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="ToolbarSmallTextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="MenuTextAppearance">
        <item name="android:fontFamily">sans-serif</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Toolbar.Button.Navigation.Tinted" parent="Widget.AppCompat.Toolbar.Button.Navigation">
        <item name="tint">?attr/colorOnPrimary</item>
    </style>

    <style name="Toolbar.Button.Overflow.Tinted" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:tint">?attr/colorOnPrimary</item>
    </style>

    <style name="TextHeadlineStyle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TabsTextStyle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="PlayerTitleTextAppearance" parent="@style/Widget.MaterialComponents.Toolbar">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/player_controls</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PlayerSubTitleTextAppearance" parent="@style/Widget.MaterialComponents.Toolbar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/player_controls</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ProfileLabelStyle">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnPrimarySecondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="PlaceholderLabelStyle">
        <item name="android:textColor">@android:color/transparent</item>
        <item name="android:background">@color/colorShimmer</item>
    </style>

    <style name="RateProgressCountStyle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="CircleShapeAppearance" parent="ShapeAppearance.MaterialComponents">
        <item name="cornerSizeBottomLeft">24dp</item>
        <item name="cornerSizeBottomRight">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyBottomLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerFamilyBottomRight">rounded</item>
    </style>

    <style name="CircleButtonStyle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="backgroundTint">@color/selector_circle_button_background_color</item>
        <item name="iconTint">@color/selector_circle_button_text_color</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/selector_circle_button_text_color</item>
        <item name="strokeColor">@color/selector_circle_button_stroke_color</item>
        <item name="android:shadowColor">?attr/colorSecondaryTransparent</item>
        <item name="rippleColor">@color/selector_button_ripple_color</item>
        <item name="shapeAppearance">@style/CircleShapeAppearance</item>
    </style>

    <style name="GrayTransparentCircleButtonStyle" parent="CircleButtonStyle">
        <item name="backgroundTint">@color/selector_gray_circle_background_color</item>
        <item name="iconTint">@color/selector_circle_button_text_color</item>
        <item name="android:textColor">@color/selector_circle_button_text_color</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/selector_button_ripple_color</item>
    </style>

    <style name="FilledCircleButtonStyle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="backgroundTint">?attr/colorSecondaryTransparent</item>
        <item name="iconTint">?attr/colorSecondary</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:shadowColor">?attr/colorSecondaryTransparent</item>
        <item name="shapeAppearance">@style/CircleShapeAppearance</item>
    </style>

    <style name="AscentChipStyle" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="checkedIcon">@drawable/ic_circle_check</item>
        <item name="checkedIconVisible">true</item>
        <item name="android:stateListAnimator" tools:targetApi="lollipop">@null</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="ActionChipStyle" parent="Widget.MaterialComponents.Chip.Action">
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="chipBackgroundColor">@drawable/selector_action_chip_background_color</item>
        <item name="chipStrokeColor">@drawable/selector_action_chip_stroke_color</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="rippleColor">@color/selector_button_ripple_color</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">
            ?attr/colorSecondaryTransparent
        </item>
    </style>

    <style name="FilterChipStyle" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="chipBackgroundColor">@color/selector_filter_chip_background_color</item>
        <item name="chipSurfaceColor">@android:color/transparent</item>
        <item name="chipStrokeColor">@drawable/selector_action_chip_stroke_color</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipIcon">@drawable/ic_minus</item>
        <item name="checkedIconEnabled">false</item>
        <item name="chipIconTint">?attr/colorSecondary</item>
        <item name="rippleColor">@color/selector_button_ripple_color</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">?attr/colorSecondaryTransparent</item>
    </style>

    <style name="EntryChipStyle" parent="Widget.MaterialComponents.Chip.Entry">
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="chipBackgroundColor">?attr/colorSecondaryTransparent</item>
        <item name="chipStrokeColor">?attr/colorSecondaryTransparent</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipIconTint">?attr/colorSecondary</item>
        <item name="rippleColor">?attr/colorPrimary</item>
        <item name="closeIconTint">?attr/colorSecondary</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">
            ?attr/colorSecondaryTransparent
        </item>
    </style>

    <style name="ActionUnelevatedButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textColor">@drawable/selector_action_button_text_color</item>
        <item name="backgroundTint">@drawable/selector_action_button_background_color</item>
        <item name="strokeColor">@drawable/selector_action_button_stroke_color</item>
        <item name="iconTint">@drawable/selector_action_button_text_color</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">10sp</item>
        <item name="android:padding">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">4dp</item>
        <item name="rippleColor">?attr/colorDivider</item>
        <item name="android:letterSpacing" tools:targetApi="lollipop">0.03</item>
    </style>

    <style name="OutlinedButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Icon">
        <item name="android:textColor">@color/selector_circle_button_text_color</item>
        <item name="backgroundTint">@color/selector_circle_button_background_color</item>
        <item name="strokeColor">@color/selector_circle_button_stroke_color</item>
        <item name="iconTint">@color/selector_circle_button_text_color</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">10sp</item>
        <item name="android:padding">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">4dp</item>
        <item name="rippleColor">?attr/colorSecondaryTransparent</item>
        <item name="android:letterSpacing" tools:targetApi="lollipop">0.03</item>
    </style>

    <style name="BackDropCardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="shapeAppearance">@style/BackDropShapeStyle</item>
        <item name="cardPreventCornerOverlap">true</item>
    </style>

    <style name="BackDropShapeStyle" parent="ShapeAppearance.MaterialComponents">
        <item name="cornerSize">16sp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="DrawerIconStyle" parent="Widget.AppCompat.DrawerArrowToggle">
        <item name="color">?attr/colorOnPrimary</item>
    </style>

    <style name="NavigationDialogMenuStyle" />
    <style name="RateNavigationMenuStyle" />

    <style name="SubtitleTextAppearance">
        <item name="android:fontFamily">sans-serif</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!--
        A text field's line and cursor take colorPrimary, a colour close to a dialog's own: the
        skip-length field could hardly be seen (BUGS #51). Here they take the accent; the field's
        states stay Material's. Its filled box is colorSurface laid under the box colour, which
        material-dialogs leaves empty - black on Amoled's grey dialogs - so the box is made
        see-through and shows whatever it sits on.
    -->
    <style name="TextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="materialThemeOverlay">@style/TextInputThemeOverlay</item>
    </style>

    <style name="TextInputThemeOverlay" parent="ThemeOverlay.MaterialComponents.TextInputEditText.FilledBox">
        <item name="colorPrimary">?attr/colorSecondary</item>
        <item name="colorSurface">@android:color/transparent</item>
    </style>

    <!--
        Replaces the material-dialogs style of the same name to add scrollbars="none". The first
        three items are copied from the library and have to stay in step with it.

        Without this a dialog title flashes a grey bar over its last letter for a moment as the
        dialog opens. Two things have to line up for it. androidx.preference puts
        android:scrollbars=vertical into the activity's own theme - PreferenceFragmentCompat.onCreate
        calls getTheme().applyStyle(PreferenceThemeOverlay) - so every view inflated from a settings
        screen, dialogs included, has a vertical scrollbar enabled. And DialogTitleLayout lays the
        title out at 2 * (measuredHeight / 2), so an odd measured height leaves the view one pixel
        shorter than its text. The title then reports itself as scrollable and draws a thumb.
    -->
    <style name="MD_Dialog_Title_Text">
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:textSize">@dimen/md_title_textsize</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:scrollbars">none</item>
    </style>

</resources>
