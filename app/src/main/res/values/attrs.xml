<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="colorSecondaryTransparent" format="color" />
    <attr name="colorOnPrimarySecondary" format="color" />
    <attr name="colorDivider" format="color" />
    <attr name="colorTransparentBackground" format="color" />
    <attr name="colorOnTransparentBackground" format="color" />
    <attr name="colorDialogSurface" format="color" />
    <attr name="colorRateMenuBackground" format="reference" />
    <attr name="colorRateDialog" format="color" />

    <attr name="colorStatusBar" format="color" />
    <attr name="colorNavigationBar" format="color" />
    <attr name="lightStatusBar" format="boolean" />

    <attr name="dialogCustomBackground" format="reference" />
    <attr name="colorSnackbarSurface" format="reference" />

    <attr name="themeStrokeWidth" format="dimension" />

    <attr name="colorRateDefault" format="color" />
    <attr name="colorRateWatched" format="color" />
    <attr name="colorRateOnHold" format="color" />
    <attr name="colorRateDropped" format="color" />

    <!--user text (P8-T4): the inline spoiler's bar and the block spoiler's button; the background of quotes
    and open spoilers; the bar beside a quote; inline code-->
    <attr name="colorTextSpoiler" format="color" />
    <!--behind the words of an open ||spoiler||, which a tap closes again-->
    <attr name="colorTextSpoilerOpen" format="color" />
    <attr name="colorTextBlockBackground" format="color" />
    <attr name="colorTextQuoteBar" format="color" />
    <attr name="colorTextCode" format="color" />
    <attr name="colorTextCodeBackground" format="color" />

    <declare-styleable name="NetworkErrorView">
        <attr name="text" format="string" />
    </declare-styleable>

    <declare-styleable name="ShikimoriContentView">
        <attr name="shikimori_content" format="string" />
        <attr name="expandable" format="boolean" />
        <!--false: the text cannot be selected, and a tap on its plain words reaches the view under it (a forum row)-->
        <attr name="content_selectable" format="boolean" />
        <attr name="content_margin" format="dimension" />
        <attr name="content_margin_top" format="dimension" />
        <attr name="content_margin_left" format="dimension" />
        <attr name="content_margin_right" format="dimension" />
        <attr name="content_margin_bottom" format="dimension" />
    </declare-styleable>

    <declare-styleable name="ThemeView">
        <attr name="appTheme" format="enum">
            <enum name="light" value="0" />
            <enum name="dark" value="1" />
            <enum name="amoled" value="2" />
        </attr>
    </declare-styleable>
</resources>
