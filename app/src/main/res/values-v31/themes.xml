<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ starts every app with its own splash: the seal (ic_launcher_foreground, masked to a circle) on
    one colour. This is the manifest's, so night: a fresh install and the dark themes. For the light theme the app
    tells Android to use ShikimoriAppTheme.Launch.Paper instead (ThemeExtensions.kt, Activity.setTheme), and Android
    keeps that for the next starts. It keeps it by the theme's name: renaming either theme loses the choice -->
    <style name="ShikimoriAppTheme.Launch" parent="ShikimoriAppTheme.LaunchBase">
        <item name="android:windowSplashScreenBackground">@color/seal_night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="ShikimoriAppTheme.Launch.Paper">
        <item name="android:windowSplashScreenBackground">@color/seal_paper</item>
    </style>

</resources>
