<?xml version="1.0" encoding="utf-8"?>
<com.infideap.drawerbehavior.AdvanceDrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorRateMenuBackground"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="true">

        <include layout="@layout/layout_default_list" />

        <include layout="@layout/layout_default_placeholders" />

        <include
            android:id="@+id/rateEmptyView"
            layout="@layout/layout_rates_placeholder" />

        <include
            android:id="@+id/authLayout"
            layout="@layout/layout_profile_auth" />

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:fitsSystemWindows="true"
            android:focusableInTouchMode="true"
            app:elevation="0dp"
            app:layout_collapseMode="pin">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/toolbarCard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardCornerRadius="8dp"
                app:cardElevation="3dp"
                app:cardPreventCornerOverlap="false"
                app:layout_scrollFlags="scroll|enterAlways|snap"
                app:strokeColor="?attr/colorDivider"
                app:strokeWidth="?attr/themeStrokeWidth">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    style="@style/ToolbarStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:fitsSystemWindows="true"
                    app:contentInsetStart="0dp"
                    app:contentInsetStartWithNavigation="0dp"
                    app:popupTheme="@style/PopupMenuTheme"
                    app:title="@string/app_name">

                    <androidx.appcompat.widget.SearchView
                        android:id="@+id/searchView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        app:closeIcon="@drawable/ic_close"
                        app:iconifiedByDefault="false"
                        app:queryBackground="@android:color/transparent"
                        app:searchIcon="@null" />

                </androidx.appcompat.widget.Toolbar>
            </com.google.android.material.card.MaterialCardView>

            <!--another user's list: whose it is. No scroll flags, so it stays at the top when the bar
            above slides away (P7-T5 Q149). A floating card, the list scrolling on behind it (Q151):
            a pill as wide as its text, as a full-width card looked like a second bar (Q155); its top
            margin is the gap below the bar, and above the pill once the bar is away. The bottom one
            keeps its shadow inside the top area, which cut it off at the pill's edge (Q156)-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ownerStrip"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:cardPreventCornerOverlap="false"
                app:strokeColor="?attr/colorDivider"
                app:strokeWidth="?attr/themeStrokeWidth"
                tools:visibility="visible">

                <!--clickable to take the taps: the list lies behind the strip, and a tap on it opened
                the title under it (P7-T5 Test 90). A label, no back button: it read as a button to open
                the list (Q154); the phone's back goes back. The avatar as far from the pill's round
                end as from its top and bottom-->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingLeft="8dp"
                    android:paddingEnd="16dp"
                    android:paddingRight="16dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ownerAvatarView"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/ownerNameView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginLeft="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnPrimarySecondary"
                        android:textSize="14sp"
                        tools:text="Список Aleks" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </com.google.android.material.appbar.AppBarLayout>


    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/transparent"
        android:maxWidth="228dp"
        android:paddingEnd="12dp"
        android:paddingRight="12dp"
        android:theme="@style/RateNavigationMenuStyle"
        app:elevation="0dp"
        app:itemIconTint="?attr/colorOnPrimary"
        app:itemTextColor="?attr/colorOnPrimary" />

</com.infideap.drawerbehavior.AdvanceDrawerLayout>