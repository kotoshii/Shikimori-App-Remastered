<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!--the blurred poster behind the head: it stays put while the page scrolls, and is made as tall
    as the head when the head is taller (BaseDetailsFragment.fitHead)-->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="517dp"
        android:fitsSystemWindows="true"
        android:scaleType="centerCrop" />

    <!--the head scrolls with the page (P7-T5 13.1). It was a collapsing header above the page, joined
    to it by fixed numbers for a one- or two-line name: a longer name showed a line across the head
    (BUGS #80), and a swipe that started on the name, a head button or the head's top did not scroll
    (BUGS #81)-->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/animeContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!--the gradient ends opaque, as the sections below are, so the poster shows only here-->
            <FrameLayout
                android:id="@+id/headContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/headGradient"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:tint="?attr/colorSurface"
                    app:srcCompat="@drawable/details_head_background_gradient" />

                <include
                    android:id="@+id/headLayout"
                    layout="@layout/layout_details_head" />

            </FrameLayout>

            <include
                android:id="@+id/infoLayout"
                layout="@layout/layout_details_info" />

            <include
                android:id="@+id/actionLayout"
                layout="@layout/layout_details_action" />

            <include
                android:id="@+id/descriptionLayout"
                layout="@layout/layout_details_description" />

            <include
                android:id="@+id/relatedLayout"
                layout="@layout/layout_details_content" />

            <include
                android:id="@+id/charactersLayout"
                layout="@layout/layout_details_content_with_search" />

            <include
                android:id="@+id/screenshotsLayout"
                layout="@layout/layout_details_content" />

            <include
                android:id="@+id/videoLayout"
                layout="@layout/layout_details_content" />

            <!--stretches to the screen's bottom when the page is shorter: the poster must not show
            below the sections-->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="?attr/colorSurface" />

        </LinearLayout>


    </androidx.core.widget.NestedScrollView>

    <!--over the page: see-through over the head, the title on its own background once the head has
    scrolled up under it (BaseDetailsFragment.updateToolbar). No shadow, as in the collapsing header,
    where it fell outside the header and was cut-->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/ToolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:popupTheme="@style/PopupMenuTheme"
        app:title="@string/app_name" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/actionBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:tint="?attr/colorOnSecondary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
