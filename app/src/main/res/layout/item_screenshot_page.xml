<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.gnoemes.shikimori.presentation.view.common.widget.TouchImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <include layout="@layout/layout_progress" />

    <!--a screenshot that did not load, with «Повторить»: the «404 not found» picture is only for a file
    the server does not have (TouchImageTargetView)-->
    <com.gnoemes.shikimori.presentation.view.common.widget.NetworkErrorView
        android:id="@+id/networkErrorView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        app:text="@string/common_error_message_without_pull" />

</FrameLayout>
