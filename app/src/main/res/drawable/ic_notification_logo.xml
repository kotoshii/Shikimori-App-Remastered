<?xml version="1.0" encoding="utf-8"?>
<!--
    The app's status bar icon: 式 alone, the character of the launcher icon's seal, as large as the 24dp canvas
    allows (a 20dp box) and with heavier strokes than in the seal (15 instead of 12 per 100), so its gaps stay
    open at status-bar size. The whole seal was tried and left out: its ring and strokes come out at about
    1.5dp there, and with 式 cut out of a filled disc the paper between the strokes is under 1dp (P7-T19).

    Only the alpha channel matters here: the system tints notification icons, so the stroke colour is
    ignored. The red comes back as the notification's accent, set in code.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:scaleX="0.2"
        android:scaleY="0.2"
        android:translateX="2"
        android:translateY="2">
        <path
            android:pathData="M6,31 L80,26 M73,3 L82,12 M45,7 C46,44 60,74 88,91 L95,77 M8,52 L34,50 M21,51 L21,82 M4,87 L40,78"
            android:strokeWidth="15"
            android:strokeColor="#ffffff"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
