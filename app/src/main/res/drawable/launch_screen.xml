<?xml version="1.0" encoding="utf-8"?>
<!--
    The splash before Android 12: the first window, drawn from the manifest's ShikimoriAppTheme.Launch before any
    app code runs, so it cannot follow the theme picked in the app. Its background, splash_background, follows the
    phone's dark mode instead (Android 10-11) and is night where there is none (Android 6-9), so a dark room never
    gets a light flash. Android 12+ shows its own splash instead (themes.xml). The seal is the launcher icon's
    foreground at the size Android 12+ gives a splash icon (288dp, the seal itself about 165dp).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:opacity="opaque">

    <item android:drawable="@color/splash_background" />

    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />

</layer-list>
