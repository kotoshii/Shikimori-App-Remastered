<?xml version="1.0" encoding="utf-8"?>
<!--
    The monochrome layer of the adaptive launcher icon: the ring and 式 of ic_launcher_foreground alone, on the
    same canvas and in the same place, so it lines up with the coloured seal.

    Android uses it in two places: the home screen's themed icons (Android 13+), and the icon of the
    group Android makes from an app's notifications when they do not all share one icon - without
    it that group shows a generic "stack". Only the shape matters; the system picks the colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M54,26.5 A27.5,27.5 0 1 1 54,81.5 A27.5,27.5 0 1 1 54,26.5 Z"
        android:strokeWidth="4.6"
        android:strokeColor="#000000" />
    <group
        android:scaleX="0.36"
        android:scaleY="0.36"
        android:translateX="36"
        android:translateY="36">
        <path
            android:pathData="M6,31 L80,26 M73,3 L82,12 M45,7 C46,44 60,74 88,91 L95,77 M8,52 L34,50 M21,51 L21,82 M4,87 L40,78"
            android:strokeWidth="12"
            android:strokeColor="#000000"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
