<?xml version="1.0" encoding="utf-8"?>
<!--The TV launcher's banner (320x180dp). Full-bleed dark surface with the accent bar, the way the
dark themes look; the launcher icon sits at the start. A vector text of the name is not possible
without a font, so the icon carries the identity - as the old release's banner did.-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0d0d0d" />
        </shape>
    </item>

    <item
        android:gravity="bottom|fill_horizontal"
        android:height="12dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorSecondary_orange" />
        </shape>
    </item>

    <item
        android:drawable="@mipmap/ic_launcher"
        android:gravity="start|center_vertical"
        android:left="32dp" />

</layer-list>
