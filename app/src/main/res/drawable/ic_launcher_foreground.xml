<?xml version="1.0" encoding="utf-8"?>
<!--
    The foreground layer of the adaptive launcher icon: a round seal - a paper disc, a red ring and 式, the first
    character of 式神, shikigami - on the 108dp canvas, inside the 66dp circle every launcher shape keeps. The
    background layer is @color/ic_launcher_background.

    Also the splash's icon: launch_screen (before Android 12) and windowSplashScreenAnimatedIcon (themes.xml, Base).
    ic_launcher_monochrome draws the same ring and 式, and the PNGs for Android 6-7.1 are rendered from the same
    shapes. 式 is six round strokes in a 100-unit box, scaled into place; stroke widths scale with the group.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/seal_paper"
        android:pathData="M54,23 A31,31 0 1 1 54,85 A31,31 0 1 1 54,23 Z" />
    <path
        android:pathData="M54,26.5 A27.5,27.5 0 1 1 54,81.5 A27.5,27.5 0 1 1 54,26.5 Z"
        android:strokeWidth="4.6"
        android:strokeColor="@color/logo_red" />
    <group
        android:scaleX="0.36"
        android:scaleY="0.36"
        android:translateX="36"
        android:translateY="36">
        <path
            android:pathData="M6,31 L80,26 M73,3 L82,12 M45,7 C46,44 60,74 88,91 L95,77 M8,52 L34,50 M21,51 L21,82 M4,87 L40,78"
            android:strokeWidth="12"
            android:strokeColor="@color/logo_red"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
